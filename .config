# Target: H3C Magic NX30 Pro (MediaTek MT7981)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
CONFIG_TARGET_mediatek_mt7981_DEVICE_h3c_magic-nx30-pro=y

# Base system
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# LuCI Applications
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y

# sing-box full (for Clash API)
CONFIG_PACKAGE_sing-box-full=y

# Memory optimization
CONFIG_PACKAGE_zram-swap=y

# Optional: remove unused packages to save space (remove # to disable)
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_ip6tables is not set
# CONFIG_PACKAGE_kmod-ip6tables is not set
# CONFIG_PACKAGE_ipv6helper is not set
